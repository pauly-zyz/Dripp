# Copy to .env next to docker-compose.yml and fill in. See DEPLOY.md.
DOMAIN=dripp.example.com
POSTGRES_PASSWORD=change-me
ADMIN_API_KEY=change-me
# Server-side RPC (indexer, API, keeper). Use a dedicated provider in production.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Deployment file written by contracts/script/Deploy.s.sol
DRIPP_DEPLOYMENT_FILE=./contracts/deployments/4663.json
CHAIN_ID=4663
# Optional: RPC used by browsers (default: viem's Robinhood Chain definition)
PUBLIC_RPC_URL=
# Optional: WalletConnect project id (enables MetaMask mobile, Rainbow, ...)
WC_PROJECT_ID=
# Keeper key with PROPOSER_ROLE on the DividendOracle (empty = dry run)
KEEPER_PRIVATE_KEY=
ALERT_WEBHOOK_URL=
COMMENT_BANNED_WORDS=
