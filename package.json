{
  "name": "dripp",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "contracts:build": "cd contracts && forge build --sizes",
    "contracts:test": "cd contracts && forge test",
    "contracts:fmt": "cd contracts && forge fmt",
    "abis": "pnpm --filter @dripp/shared gen:abis",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "bash scripts/e2e-local.sh"
  },
  "devDependencies": {
    "@types/node": "22",
    "typescript": "5.9.3",
    "vitest": "3"
  }
}
